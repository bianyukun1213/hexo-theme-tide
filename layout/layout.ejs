<% const tideCtx=get_ctx(site,config,theme,page) %>
<!DOCTYPE html>
<html lang="<%= tideCtx.language %>" dir="<%= tideCtx.site_dir %>">

<head>
  <%- partial('./partials/res/res-head-begin.ejs',{tideCtx},{cache:tideCtx.fragment_cache}) %>
  <%- partial('./partials/meta.ejs',{tideCtx}) %>
  <%- partial('./partials/res/res-head-end.ejs',{tideCtx},{cache:tideCtx.fragment_cache}) %>
</head>

<body class="un-text-base un-text-txt-prim un-break-words">
  <%- partial('./partials/res/res-body-begin.ejs',{tideCtx},{cache:tideCtx.fragment_cache}) %>
  <!-- <textarea id="ctx" style="display:none;" class="un-fixed un-size-96 un-right-0 un-bottom-0 un-z-100"><%#= JSON.stringify(tideCtx,null,2) %></textarea> -->
  <!-- <textarea id="ctx" class="un-fixed un-size-96 un-right-0 un-bottom-0 un-z-100"><%#= JSON.stringify(tideCtx) %></textarea> -->
  <div id="tide-root" class="un-bg-b-scnd un-absolute un-size-full un-text-base">
    <%- partial('./partials/sidebar.ejs',{tideCtx}) %>
    <div id="tide-content" class="un-sc-trans-default un-fixed un-size-full un-flex un-flex-col">
      <%- partial('./partials/top-bar.ejs',{tideCtx}) %>
      <div id="tide-main-content-frame" class="un-bg-bg-prim un-flex-1 un-overflow-auto">
        <main id="tide-main-content" dir="<%= tideCtx.page_dir %>" class="un-max-w-[80ch] un-mx-auto">
          <%- body %>
        </main>
      </div>
      <%- partial('./partials/floating-widgets.ejs',{tideCtx}) %>
    </div>
  </div>
  <%- partial('./partials/res/res-body-end.ejs',{tideCtx}) %>
</body>

</html>